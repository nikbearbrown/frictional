{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frictional report",
  "type": "object",
  "required": [
    "schema_version",
    "skill_version",
    "created_at",
    "target",
    "model",
    "dimensions",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "skill_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "target": {
      "type": "object",
      "description": "Only safe, redacted assessment metadata. Never include secrets or raw logs."
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "mode": {
      "enum": [
        "student",
        "instructor"
      ]
    },
    "glp": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/glp"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_step"
      }
    },
    "run": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/run"
        }
      ]
    }
  },
  "description": "Frictional v1 and v2; no grading. Version 2 adds mode, the seven GLP components with their evidence sources (never a GLP score), prioritized next steps with acceptance checks, and an optional container-run summary. Dimension IDs must be unique (checked at runtime). Missing evidence does not imply absence of learning. Only redacted, necessary observations and locators may be included.",
  "allOf": [
    {
      "if": {
        "properties": {
          "dimensions": {
            "contains": {
              "properties": {
                "interpretations": {
                  "minItems": 1
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "glp",
          "next_steps",
          "run"
        ]
      },
      "else": {
        "properties": {
          "mode": false,
          "glp": false,
          "next_steps": false,
          "run": false
        }
      }
    }
  ],
  "$defs": {
    "dimension": {
      "type": "object",
      "required": [
        "id",
        "family",
        "version",
        "status",
        "facts",
        "interpretations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "family": {
          "enum": [
            "artifact",
            "process"
          ]
        },
        "version": {
          "type": "integer",
          "const": 1
        },
        "status": {
          "enum": [
            "reported",
            "no_evidence",
            "blocked",
            "not_applicable",
            "not_assessed",
            "hidden_by_instructor"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "interpretations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "reported"
                }
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "maxItems": 0
              },
              "interpretations": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "observation",
        "locator",
        "alternative_explanations"
      ],
      "additionalProperties": false,
      "properties": {
        "observation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "glp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "sources",
        "note"
      ],
      "properties": {
        "id": {
          "enum": [
            "Y1",
            "Y2",
            "Y3",
            "Y4",
            "Y5",
            "Y6",
            "Y7"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "evidence_recorded",
            "no_evidence",
            "needs_course_data"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "status": {
                "enum": [
                  "reported",
                  "no_evidence",
                  "blocked",
                  "not_applicable",
                  "not_assessed",
                  "hidden_by_instructor"
                ]
              }
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "dimension",
        "locator",
        "change",
        "check"
      ],
      "properties": {
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "dimension": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "change": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "check": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "image",
        "outcomes",
        "receipt",
        "spec_source"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "receipt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "spec_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
