#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# Frictional needs Python 3.10 or newer. Use python3 when it is new enough,
# otherwise the newest python3.N on PATH that is. If none is, run python3
# anyway: frictional_cli.py then says which version it needs and where to get it.
for py in python3 python3.15 python3.14 python3.13 python3.12 python3.11 python3.10; do
  if command -v "$py" >/dev/null 2>&1 &&
     "$py" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    exec "$py" "$root/frictional_cli.py" "$@"
  fi
done
if ! command -v python3 >/dev/null 2>&1; then
  echo "frictional: needs Python 3.10 or newer, and no python3 was found." >&2
  echo "Install Python from https://www.python.org/downloads/, then run the command again." >&2
  exit 1
fi
exec python3 "$root/frictional_cli.py" "$@"
